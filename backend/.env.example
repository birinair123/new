# Database
DATABASE_URL=postgresql://crm:crm@localhost:5432/linkedin_crm

# Authentication
AUTH_PASSWORD=changeme
AUTH_SECRET_KEY=your-secret-key-here

# Your email addresses (comma-separated, for direction detection)
OWN_EMAILS=you@example.com,your.name@company.com

# IMAP Configuration (optional)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your@gmail.com
IMAP_PASSWORD=app-specific-password
IMAP_USE_SSL=true

# Paths
DATA_DIR=./data
JSONL_IMPORT_DIR=./data/imports
LINKEDIN_CSV_DIR=./data/linkedin
OST_EXPORT_DIR=/shared/crm_export

# Privacy settings
STORE_EMAIL_SNIPPETS=true
SNIPPET_MAX_LENGTH=200

# Debug
DEBUG=false
